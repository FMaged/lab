# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp example.env .env
#   set -a; . ./.env; set +a
#
# One file for every credential in the project, loaded once before running any
# tool. Non-secret tunables (node names, datastores, VLAN IDs, ISO filenames)
# stay in each layer's example.tfvars / example.pkrvars.hcl — only secrets and
# connection endpoints live here. See the secrets decision in PLAN.md.
#
# Never commit the filled-in .env. Never paste a real value into this file.

# --- Proxmox API: terraform/ and opnsense/ (the bpg provider reads these directly)
# Both tokens below are minted by proxmox/first-boot-hook.sh on first boot,
# not by scripts/init-env.sh — copy them in from /root/proxmox-api-tokens.txt
# on the host once it's up (PLAN.md's zero-touch decision).
PROXMOX_VE_ENDPOINT=https://proxmox.example.internal:8006/
PROXMOX_VE_API_TOKEN=root@pam!terraform=REPLACE_ME
# true only while the host still has its self-signed certificate.
PROXMOX_VE_INSECURE=true

# --- Proxmox API: packer/ (its own token, so it can be revoked separately)
PKR_VAR_proxmox_url=https://proxmox.example.internal:8006/api2/json
PKR_VAR_proxmox_api_token_id=root@pam!packer
PKR_VAR_proxmox_api_token_secret=REPLACE_ME

# --- Proxmox host's own root password (proxmox/answer.toml, rendered by
# --- scripts/prepare-proxmox-iso.sh). Only the hash is ever templated into
# --- the rendered answer file; the plaintext exists here purely so the
# --- operator can still log in afterward — nothing reads it programmatically.
PROXMOX_ROOT_PASSWORD=REPLACE_ME
PROXMOX_ROOT_PASSWORD_HASH=REPLACE_ME

# --- OPNsense API: opnsense/. Generated by scripts/init-env.sh and baked into
# --- packer/files/config.xml at build time — see the zero-touch decision in
# --- PLAN.md. OPNSENSE_URI still depends on a host that doesn't exist yet.
OPNSENSE_URI=https://10.10.10.1
OPNSENSE_API_KEY=REPLACE_ME
OPNSENSE_API_SECRET=REPLACE_ME

# --- OPNsense root user: packer/opnsense.pkr.hcl rotates root to this password
# --- over SSH after install (config.xml itself only ever carries a fixed,
# --- non-secret bootstrap hash — see the correction on PLAN.md's OPNsense SPIKE
# --- decision). The API secret's hash, unlike the root password, does reach
# --- config.xml directly, since it is never typed anywhere.
PKR_VAR_opnsense_root_password=REPLACE_ME
PKR_VAR_opnsense_api_secret_hash=REPLACE_ME

# --- Guest credentials.
# The two local-admin values MUST be identical: Packer bakes the password into
# the templates, and Terraform's WinRM connection then authenticates with it.
# They are separate variables only because they belong to different tools.
PKR_VAR_local_admin_password=REPLACE_ME
TF_VAR_local_admin_password=REPLACE_ME

# Becomes the domain Administrator password on promotion, and joins SRV01/CL01.
TF_VAR_domain_admin_password=REPLACE_ME

# Directory Services Restore Mode. DC01's Install-ADDSForest only.
TF_VAR_dsrm_recovery_password=REPLACE_ME
