# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
*.tfvars.json
crash.log
crash.*.log

# Packer
packer_cache/
*.pkrvars.hcl
!example.pkrvars.hcl
packer-manifest.json
*.box

# Secrets — one .env at the root holds every credential (see PLAN.md).
# The negation matters: without it, *.env swallows the committed template.
.env
*.env
!example.env
.env.*

# Proxmox host self-install (zero-touch) — the rendered answer file carries a
# real password hash, and a prepared ISO embeds the rendered file whole.
# Neither is ever committed (PLAN.md's zero-touch decision).
proxmox/answer.rendered.toml
proxmox/*.iso

# OS / editor
.DS_Store

# Claude Code session runtime state — not project content
.claude/scheduled_tasks.lock
